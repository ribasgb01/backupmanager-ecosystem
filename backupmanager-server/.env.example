# Backup Manager - variáveis utilizadas pelo docker-compose.yml da raiz.
# Copie este arquivo para .env e substitua os valores de exemplo.
# Não versione o arquivo .env real.

# PostgreSQL
POSTGRES_DB=backupmanager
POSTGRES_USER=backupmanager
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# S3-compatible storage (MinIO/Silo)
# Estas credenciais também são usadas como MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
STORAGE_S3_BUCKET_NAME=backup-manager
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=backupmanager-local
STORAGE_S3_SECRET_KEY=CHANGE_ME_STORAGE_SECRET

# JWT expirations in milliseconds
# Access token: 15 minutes
API_SECURITY_TOKEN_ACCESS_EXPIRATION=900000
# Refresh token: 7 days
API_SECURITY_TOKEN_REFRESH_EXPIRATION=604800000

# Signing secret used by JWT (minimum 32 bytes for the HMAC key).
# Generate a strong random value before using this outside local development.
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
