# PostgreSQL
POSTGRES_DB=backupmanager
POSTGRES_USER=backupmanager
POSTGRES_PASSWORD=change-me

# S3-compatible storage (Silo)
STORAGE_S3_BUCKET_NAME=backupmanager
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=change-me
STORAGE_S3_SECRET_KEY=change-me

# JWT
# Use a long, random secret appropriate for your application's JWT implementation.
JWT_SECRET=replace-with-a-long-random-secret

# Token expiration values
# Keep the units/format expected by your Spring Boot configuration.
API_SECURITY_TOKEN_ACCESS_EXPIRATION=900000
API_SECURITY_TOKEN_REFRESH_EXPIRATION=604800000
